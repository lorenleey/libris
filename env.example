# Copia este archivo a ".env" (que ya está en .gitignore) y ajusta los valores.
# No subas nunca el ".env" real al repositorio.

# Autenticación de Windows (la más sencilla si SSMS ya te conecta así):
SQL_CONN_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=Libris;Trusted_Connection=yes;TrustServerCertificate=yes;

# Alternativa con usuario y contraseña de SQL Server (descomenta y rellena):
# SQL_CONN_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=Libris;UID=tu_usuario;PWD=tu_contraseña;TrustServerCertificate=yes;

# Modelo de chat por defecto (puede cambiarse también desde la interfaz)
LIBRIS_CHAT_MODEL=qwen2.5:3b
